# ==========================================
# NAMOH Backend Environment Example
# ==========================================

# PostgreSQL database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/namoh?schema=public"

# Backend server port
PORT=3000

# Secret key for signing JWT tokens
JWT_SECRET_KEY="your-super-secret-jwt-key"

# Frontend application URL allowed for CORS and cookie credentials
FRONTEND_URL="http://localhost:5173"

